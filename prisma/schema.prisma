generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ListingStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum ListingVisibility {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String
  whatsapp      String?
  officeAddress String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Listing {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  propertyType   String
  price          Int
  summary        String
  description    String
  address        String
  mapUrl         String
  bedrooms       Int
  bathrooms      Float
  area           Int
  areaUnit       String
  listingStatus  ListingStatus     @default(AVAILABLE)
  visibility     ListingVisibility @default(DRAFT)
  contactName    String
  contactEmail   String
  contactPhone   String
  contactWhatsapp String?
  officeAddress  String?
  featured       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  images         ListingImage[]
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  altText   String?
  position  Int
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}
